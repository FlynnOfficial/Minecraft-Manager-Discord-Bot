DISCORD_TOKEN=preencha_o_token
OWNER_DISCORD_ID=111111111111111111
FRIEND_DISCORD_ID=222222222222222222
DISCORD_GUILD_ID=333333333333333333
DISCORD_CHANNEL_ID=444444444444444444

CRAFTY_URL=https://127.0.0.1:8443
CRAFTY_TOKEN=preencha_o_token
CRAFTY_SERVER_ID=00000000-0000-0000-0000-000000000000
CRAFTY_VERSION=4.11.0
# Use CA confiável OU fingerprint SHA-256 do certificado verificado localmente.
# Nunca existe opção de desativar TLS neste projeto.
CRAFTY_CA_FILE=
CRAFTY_CERT_SHA256=
CRAFTY_TIMEZONE=America/Sao_Paulo

# Deve apontar para O MESMO servidor escolhido por CRAFTY_SERVER_ID.
# Somente loopback; enable-status=true no server.properties.
MC_STATUS_HOST=127.0.0.1
MC_STATUS_PORT=25565

POLL_SECONDS=30
HTTP_TIMEOUT_SECONDS=10
STATUS_TIMEOUT_SECONDS=5
STATS_MAX_AGE_SECONDS=90
OPERATION_POLL_SECONDS=10
START_TIMEOUT_SECONDS=240
STOP_TIMEOUT_SECONDS=300
CONFIRM_SECONDS=30
COOLDOWN_SECONDS=10
# Heartbeat do embed mesmo sem mudanças: informa uma checagem publicada recente.
PANEL_HEARTBEAT_SECONDS=300
DATA_DIR=data
LOG_DIR=logs
